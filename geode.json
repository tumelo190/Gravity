{
  "geode": "3.0.0",
  "version": "1.8.0",
  "id": "gravity",
  "name": "Gravity",
  "developer": "tumelo190",
  "description": "Advanced mod menu for Geometry Dash with 200+ toggles (Mobile) and 160 toggles (PC) - Eclipse alternative with more features",
  "long_description": "Gravity is a comprehensive mod menu system for Geometry Dash featuring:\n- 200+ toggles on Mobile\n- 160 toggles on PC\n- 50 mobile themes\n- 35 PC themes\n- Floating action button\n- Tab-based navigation\n- Persistent settings\n- Click bot & Macro bot\n- Practice mode system\n- Speed controls and visual effects",
  "homepage": "https://github.com/tumelo190/Gravity",
  "repository": "https://github.com/tumelo190/Gravity",
  "issues": "https://github.com/tumelo190/Gravity/issues",
  "about": {
    "title": "Gravity Mod Menu",
    "description": "A comprehensive mod menu for Geometry Dash",
    "credits": [
      {
        "name": "tumelo190",
        "role": "Developer & Creator"
      }
    ]
  },
  "settings": {
    "menu_enabled": {
      "name": "Menu Enabled",
      "description": "Enable/disable the Gravity mod menu",
      "type": "bool",
      "default": true
    },
    "menu_style": {
      "name": "Menu Style",
      "description": "Auto-detect platform or choose manually",
      "type": "string",
      "default": "auto",
      "options": ["auto", "mobile", "pc"]
    },
    "theme": {
      "name": "Theme",
      "description": "Select your preferred theme color scheme",
      "type": "string",
      "default": "dark_blue"
    },
    "auto_save": {
      "name": "Auto Save Settings",
      "description": "Automatically save toggle states",
      "type": "bool",
      "default": true
    }
  },
  "features": [
    "200+ toggles on Mobile",
    "160 toggles on PC",
    "50 mobile themes",
    "35 PC themes",
    "Persistent settings",
    "Floating action button",
    "Tab-based navigation",
    "Click bot & Macro bot",
    "Practice mode system",
    "Dark/Light themes",
    "Speed controls",
    "Visual effects",
    "Audio controls",
    "Movement modifiers"
  ],
  "dependencies": [],
  "api": "v2.1.0",
  "minGeodeVersion": "2.0.0",
  "resources": {
    "logo": "https://raw.githubusercontent.com/tumelo190/Gravity/main/assets/logo.png",
    "banner": "https://raw.githubusercontent.com/tumelo190/Gravity/main/assets/banner.png"
  },
  "tags": [
    "menu",
    "utility",
    "enhancement",
    "gameplay",
    "visual"
  ]
}
